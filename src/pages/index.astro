---
import MainLayout from "@/layouts/MainLayout.astro"
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---

<MainLayout title="Alexandre Serra — Software & Dados">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-identity"><strong>Alexandre Serra</strong><span>Software Engineer</span></p>
        <p class="eyebrow" data-i18n="home.eyebrow">Data & Distributed Systems · Go, Python, Rust, SQL, RAG/GenAI</p>
        <h1 data-i18n="home.title">Sistemas distribuídos e plataformas de dados para a complexidade do <em>mundo real.</em></h1>
        <p class="intro" data-i18n="home.intro">Engenheiro de software formado em Engenharia Informática e Computação pela Faculdade de Engenharia da Universidade do Porto (FEUP). Trabalho entre backend, dados e IA aplicada, projetando sistemas distribuídos para operações em que desempenho, contexto e confiabilidade não são opcionais.</p>
        <div class="hero-actions"><a href={`${base}experiencia`} class="btn" data-i18n-pt="Conheça minha trajetória ↗" data-i18n-en="Explore my experience ↗">Conheça minha trajetória ↗</a><a href={`${base}contato`} class="btn btn--secondary" data-i18n="home.contact">Entre em contato</a></div>
      </div>
      <div class="hero-profile">
        <div class="hero-art"><img src={`${base}images/alexandre-serra-hero.png`} alt="Retrato ilustrado de Alexandre Serra" /></div>
        <div class="profile-links" aria-label="Links profissionais"><a href="mailto:alexandreapserraa@gmail.com?subject=Contato%20pelo%20portf%C3%B3lio&amp;body=Ol%C3%A1%2C%20Alexandre%21%0A%0A" aria-label="Enviar e-mail"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.5h17A1.5 1.5 0 0122 7v10a1.5 1.5 0 01-1.5 1.5h-17A1.5 1.5 0 012 17V7a1.5 1.5 0 011.5-1.5Zm0 2v.18l8.5 5.6 8.5-5.6V7.5h-17Zm17 9V9.47l-8.1 5.34a.75.75 0 01-.8 0L3.5 9.47v7.03h17Z"/></svg></a><a href="https://github.com/alexandreserra1" target="_blank" rel="noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.59 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.2-3.37-1.2-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.15-4.56-5.1 0-1.13.39-2.05 1.03-2.77-.1-.26-.45-1.32.1-2.74 0 0 .84-.28 2.75 1.06A9.3 9.3 0 0112 5.85c.85 0 1.7.12 2.5.34 1.91-1.34 2.74-1.06 2.74-1.06.55 1.42.2 2.48.1 2.74.64.72 1.03 1.64 1.03 2.77 0 3.96-2.35 4.83-4.58 5.08.36.33.68.95.68 1.91 0 1.38-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.27 10.27 0 0022 12.25C22 6.59 17.52 2 12 2Z"/></svg></a><a href="https://www.linkedin.com/in/alexandreapserra/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.37 3.5a1.87 1.87 0 11-3.74 0 1.87 1.87 0 013.74 0zM1.9 7.03h3.49V22H1.9V7.03zM7.58 7.03h3.34v2.04h.05c.46-.89 1.6-2.04 3.3-2.04 3.53 0 4.18 2.36 4.18 5.43V22h-3.48v-8.43c0-2.01-.04-4.6-2.76-4.6-2.77 0-3.2 2.2-3.2 4.46V22H5.53V7.03h2.05z"/></svg></a></div>
      </div>
    </div>
    <div class="container capability-bar"><span>Python</span><span>Go</span><span>Rust</span><span>PostgreSQL</span><span>ClickHouse</span><span>Kafka</span><span>AWS</span><span>Docker</span><span>TypeScript</span><span>React</span></div>
  </section>

  <section class="section container focus-section">
    <div class="section-heading"><div><p class="eyebrow" data-i18n="home.capabilities">Capacidades centrais</p><h2 data-i18n="home.principles-title">Engenharia com contexto.</h2></div><p data-i18n="home.principles-copy">Do desenho ao deploy, equilibro decisões técnicas, impacto para o negócio e a experiência de quem mantém o produto.</p></div>
    <div class="principles"><article><span>01</span><h3 data-i18n-pt="Arquitetura distribuída" data-i18n-en="Distributed architecture">Arquitetura distribuída</h3><p data-i18n-pt="Serviços, contratos e domínios bem definidos para evoluir sem perder a operação." data-i18n-en="Services, contracts and domains designed to evolve without compromising operations.">Serviços, contratos e domínios bem definidos para evoluir sem perder a operação.</p></article><article><span>02</span><h3 data-i18n-pt="Plataformas de dados" data-i18n-en="Data platforms">Plataformas de dados</h3><p data-i18n-pt="Pipelines de baixa latência que transformam informação operacional em decisão." data-i18n-en="Low-latency pipelines that turn operational information into decisions.">Pipelines de baixa latência que transformam informação operacional em decisão.</p></article><article><span>03</span><h3 data-i18n-pt="IA confiável" data-i18n-en="Reliable AI">IA confiável</h3><p data-i18n-pt="RAG e LLMs com avaliação, guardrails e privacidade desde a arquitetura." data-i18n-en="RAG and LLMs built around evaluation, guardrails and privacy from the architecture up.">RAG e LLMs com avaliação, guardrails e privacidade desde a arquitetura.</p></article></div>
  </section>

  <section class="container section cta-section"><p class="eyebrow" data-i18n="home.cta">Próxima conversa</p><div><h2 data-i18n="home.cta-title">Tem um problema interessante<br />para resolver?</h2><a href={`${base}contato`} class="btn" data-i18n="home.cta-button">Vamos conversar <span aria-hidden="true">↗</span></a></div></section>
</MainLayout>

<style>
  .hero { background: var(--sand); padding: clamp(3.5rem, 7vw, 5.8rem) 0 0; position: relative; }
  .hero::before { background: radial-gradient(circle, rgb(201 101 72 / 18%) 0 1px, transparent 1.5px) 0 0 / 15px 15px; content: ""; height: 32%; opacity: .8; position: absolute; right: 0; top: 0; width: 28%; }
  .hero-grid { align-items: center; display: grid; gap: 3rem; grid-template-columns: 1.15fr .85fr; position: relative; }
  .hero-identity { align-items: baseline; display: flex; gap: .65rem; margin-bottom: .8rem; }.hero-identity strong { color: var(--ink); font-family: "Fraunces", Georgia, serif; font-size: clamp(1.2rem, 2vw, 1.45rem); letter-spacing: -.035em; }.hero-identity span { color: var(--muted); font-family: "DM Mono", monospace; font-size: .67rem; letter-spacing: .08em; text-transform: uppercase; }.hero-copy h1 { margin: 1.3rem 0 1.5rem; max-width: 49rem; }
  .hero-copy h1 em { color: var(--moss); font-style: normal; }
  .intro { color: var(--ink-soft); font-size: clamp(.98rem, 1.5vw, 1.1rem); line-height: 1.65; max-width: 39rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.2rem; }
  .hero-profile { justify-self: end; max-width: 17rem; width: 100%; }.hero-art { aspect-ratio: 1; background: var(--moss-deep); border: 5px solid var(--paper); border-radius: 50%; box-shadow: var(--shadow); overflow: hidden; position: relative; width: 100%; }.hero-art img { height: 100%; object-fit: cover; width: 100%; }.profile-links { display: flex; gap: .55rem; justify-content: center; margin-top: .85rem; }.profile-links a { align-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--moss); display: inline-flex; height: 2rem; justify-content: center; transition: background .2s, border-color .2s, color .2s, transform .2s; width: 2rem; }.profile-links a:hover { background: var(--moss-deep); border-color: var(--moss-deep); color: var(--paper); transform: translateY(-3px); }.profile-links svg { fill: currentColor; height: .95rem; width: .95rem; }
  .capability-bar { border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 1.4rem 2.3rem; margin-top: clamp(3rem, 7vw, 6rem); padding: 1.2rem 0; }.capability-bar span { color: var(--moss); font-family: "DM Mono", monospace; font-size: .7rem; }
  .section-heading h2 { margin-top: .8rem; }.principles { border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(3, 1fr); }.principles article { border-right: 1px solid var(--line); padding: 1.45rem 1.5rem 1.45rem 0; }.principles article + article { padding-left: 1.5rem; }.principles article:last-child { border-right: 0; }.principles span { color: var(--clay); font-family: "DM Mono", monospace; font-size: .7rem; }.principles h3 { margin: 1.75rem 0 .6rem; }.principles p { color: var(--muted); font-size: .88rem; max-width: 17rem; }
  .cta-section { align-items: end; display: flex; justify-content: space-between; }.cta-section h2 { margin-top: .8rem; }.cta-section > div { text-align: right; }.cta-section .btn { margin-top: 1.2rem; }
  @media (max-width: 800px) { .hero { padding-top: 3rem; }.hero-grid { gap: 2.25rem; grid-template-columns: 1fr; }.hero-profile { justify-self: start; max-width: 12rem; }.capability-bar { gap: .8rem 1.2rem; margin-top: 3rem; }.principles { grid-template-columns: 1fr; }.principles article, .principles article + article { border-bottom: 1px solid var(--line); border-right: 0; padding: 1.5rem 0; }.principles article:last-child { border-bottom: 0; }.principles h3 { margin-top: 1.4rem; }.cta-section { align-items: start; flex-direction: column; gap: 1.2rem; }.cta-section > div { text-align: left; } } @media (max-width: 420px) { .hero-actions { display: grid; grid-template-columns: 1fr; }.hero-actions .btn { width: 100%; }.hero-profile { max-width: 10rem; }.capability-bar { gap: .65rem 1rem; }.capability-bar span { font-size: .64rem; }.cta-section h2 br { display: none; } }
</style>
