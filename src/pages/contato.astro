---
import MainLayout from "@/layouts/MainLayout.astro"
---

<MainLayout title="Contato">
  <section class="contact-hero"><div class="container"><p class="eyebrow" data-i18n="contact.eyebrow">Contato</p><h1 data-i18n="contact.title">Vamos construir algo que <em>importe.</em></h1><p class="intro" data-i18n="contact.copy">Estou sempre aberto a conversar sobre produto, sistemas, dados e boas oportunidades para criar impacto.</p><button type="button" class="email-link" data-contact-open aria-haspopup="dialog">alexandreapserraa@gmail.com <span aria-hidden="true">↗</span></button></div></section>
  <section class="container section section--tight"><div class="contact-grid"><a href="https://www.linkedin.com/in/alexandreapserra/" target="_blank" rel="noreferrer" class="contact-card"><span>01</span><div><h2>LinkedIn</h2><p data-i18n="contact.linkedin">Conecte-se para acompanhar minha trajetória profissional.</p></div><b aria-hidden="true">↗</b></a><a id="github-profile" href="https://github.com/alexandreserra1" target="_blank" rel="noreferrer" class="contact-card"><span>02</span><div><h2>GitHub</h2><p data-i18n="contact.github">Veja projetos, experimentos e o código por trás das ideias.</p></div><b aria-hidden="true">↗</b></a></div></section>
</MainLayout>

<style>
  .contact-hero { background: var(--moss-deep); color: #fffdf8; padding: clamp(4.5rem, 10vw, 8rem) 0; position: relative; }.contact-hero::after { border: 1px solid rgb(255 253 248 / .14); border-radius: 50%; content: ""; height: 36rem; position: absolute; right: -15rem; top: -11rem; width: 36rem; }.contact-hero .container { position: relative; z-index: 1; }.contact-hero .eyebrow { color: #d9e2d1; }.contact-hero .eyebrow::before { background: #df8b64; }.contact-hero h1 { color: #fffdf8; margin: 1.1rem 0 1.3rem; max-width: 52rem; }.contact-hero h1 em { color: #e5a17e; font-style: normal; }.intro { color: #c8d3c3; font-size: 1.1rem; max-width: 38rem; }.email-link { background: transparent; border: 0; border-bottom: 1px solid rgb(255 253 248 / .65); color: #fffdf8; cursor: pointer; display: inline-block; font-family: "DM Mono", monospace; font-size: clamp(1rem, 3vw, 1.35rem); margin-top: 2.5rem; padding: 0 0 .35rem; text-align: left; }.email-link:hover { color: #ffd0ba; }.email-link span { color: #ffd0ba; }.email-link:focus-visible { outline: 3px solid #e59a77; outline-offset: 3px; }:global(:root[data-theme="dark"]) .contact-hero { background: #101b13; }.contact-hero .intro { color: #d5dfd1; }
  .contact-grid { display: grid; grid-template-columns: repeat(2, 1fr); }.contact-card { align-items: end; background: var(--paper); border: 1px solid var(--line); display: grid; gap: 1rem; grid-template-columns: auto 1fr auto; min-height: 15rem; padding: 1.5rem; transition: background .2s, transform .2s; }.contact-card:first-child { border-radius: var(--radius) 0 0 var(--radius); }.contact-card:last-child { border-left: 0; border-radius: 0 var(--radius) var(--radius) 0; }.contact-card:hover { background: var(--moss-pale); transform: translateY(-3px); }.contact-card > span { align-self: start; color: var(--clay); font-family: "DM Mono", monospace; font-size: .7rem; }.contact-card h2 { font-size: 2rem; }.contact-card p { color: var(--muted); font-size: .88rem; margin-top: .5rem; max-width: 16rem; }.contact-card b { color: var(--clay); font-size: 1.5rem; font-weight: 400; } @media (max-width: 600px) { .contact-grid { grid-template-columns: 1fr; }.contact-card:first-child { border-radius: var(--radius) var(--radius) 0 0; }.contact-card:last-child { border-left: 1px solid var(--line); border-radius: 0 0 var(--radius) var(--radius); border-top: 0; } }
</style>
