---
export interface Props { title: string; titleEn: string; description: string; descriptionEn: string; technologies: string[]; image?: string; githubUrl?: string; demoUrl?: string }
const { title, titleEn, description, descriptionEn, technologies, image, githubUrl, demoUrl } = Astro.props
const monogram = title.split(" ").map(word => word[0]).join("").slice(0, 2).toUpperCase()
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const imageSrc = image?.startsWith("/") ? `${base}${image.slice(1)}` : image
---

<article class="card project-card">
  <div class="project-visual" class:list={{ "has-image": Boolean(image) }}>{imageSrc ? <img src={imageSrc} alt={title} /> : <><span class="project-number">/ 0{technologies.length}</span><strong>{monogram}</strong><i></i></>}</div>
  <div class="project-body"><div><h3 data-i18n-pt={title} data-i18n-en={titleEn}>{title}</h3><p data-i18n-pt={description} data-i18n-en={descriptionEn}>{description}</p></div><div class="tags">{technologies.map(tech => <span class="tag">{tech}</span>)}</div>{(githubUrl || demoUrl) && <div class="links">{githubUrl && <a href={githubUrl} target="_blank" rel="noreferrer" class="project-link project-link--github"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.59 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.2-3.37-1.2-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.15-4.56-5.1 0-1.13.39-2.05 1.03-2.77-.1-.26-.45-1.32.1-2.74 0 0 .84-.28 2.75 1.06A9.3 9.3 0 0112 5.85c.85 0 1.7.12 2.5.34 1.91-1.34 2.74-1.06 2.74-1.06.55 1.42.2 2.48.1 2.74.64.72 1.03 1.64 1.03 2.77 0 3.96-2.35 4.83-4.58 5.08.36.33.68.95.68 1.91 0 1.38-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.27 10.27 0 0022 12.25C22 6.59 17.52 2 12 2Z" /></svg><span data-i18n="project.code">Ver código no GitHub</span><b aria-hidden="true">↗</b></a>}{demoUrl && <a href={demoUrl} target="_blank" rel="noreferrer" class="project-link" data-i18n="project.view">Ver projeto <span aria-hidden="true">↗</span></a>}</div>}</div>
</article>

<style>
  .project-card { display: flex; flex-direction: column; min-height: 100%; overflow: hidden; transition: box-shadow .25s, transform .25s; }.project-card:hover { box-shadow: var(--shadow); transform: translateY(-4px); }
  .project-visual { align-items: center; background: var(--moss-deep); display: flex; height: 12.5rem; justify-content: center; overflow: hidden; position: relative; }.project-card:nth-child(even) .project-visual { background: #9f523e; }.project-visual.has-image { background: var(--moss-pale); }.project-visual img { height: 100%; object-fit: cover; width: 100%; }.project-visual strong { color: #eff0df; font-family: "Fraunces", Georgia, serif; font-size: 4rem; font-weight: 600; letter-spacing: -.08em; position: relative; z-index: 1; }.project-visual i { border: 1px solid rgb(255 253 248 / .35); border-radius: 50%; height: 12rem; position: absolute; transform: rotate(-35deg); width: 8rem; }.project-number { color: #f2dfd4; font-family: "DM Mono", monospace; font-size: .68rem; left: 1rem; position: absolute; top: 1rem; }
  .project-body { display: flex; flex: 1; flex-direction: column; gap: 1.25rem; padding: 1.4rem; }.project-body p { color: var(--muted); font-size: .9rem; line-height: 1.6; margin-top: .65rem; }.tags { display: flex; flex-wrap: wrap; gap: .4rem; }.links { display: flex; gap: 1rem; margin-top: auto; }.project-link { color: var(--moss); font-size: .82rem; font-weight: 700; }.project-link:hover { color: var(--clay-deep); }.project-link span { color: var(--clay); }.project-link--github { align-items: center; background: var(--moss-deep); border: 1px solid var(--moss-deep); border-radius: 99px; color: var(--sand); display: inline-flex; gap: .5rem; padding: .62rem .82rem; transition: background-color .2s, border-color .2s, transform .2s; }.project-link--github svg { fill: currentColor; height: 1rem; width: 1rem; }.project-link--github span { color: inherit; }.project-link--github b { color: var(--clay); font-size: .9rem; line-height: 1; }.project-link--github:hover { background: var(--clay-deep); border-color: var(--clay-deep); color: #fffdf8; transform: translateY(-2px); }
</style>
