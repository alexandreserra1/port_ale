---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro"
import ThemeToggle from "@/components/ThemeToggle.astro"
const currentPath = Astro.url.pathname
const base = import.meta.env.BASE_URL
const links = [
  { href: `${base}sobre`, label: "Sobre", key: "nav.about" },
  { href: `${base}experiencia`, label: "Experiência", key: "nav.experience" },
  { href: `${base}projetos`, label: "Projetos", key: "nav.projects" },
  { href: `${base}blog`, label: "Blog", key: "nav.notes" },
]
---

<header>
  <div class="container header-inner">
    <a href={base} class="brand" aria-label="Alexandre Serra — início"><span>AS</span><i>.</i></a>
    <nav aria-label="Navegação principal">
      {links.map(link => <a href={link.href} class:list={["nav-link", { active: currentPath === link.href }]} data-i18n={link.key}>{link.label}</a>)}
    </nav>
    <div class="header-actions"><ThemeToggle /><LanguageSwitcher /><a href={`${base}contato`} class="contact-link" data-i18n="nav.contact">Vamos conversar</a><span class="contact-arrow" aria-hidden="true">↗</span></div>
  </div>
</header>

<style>
  header { background: rgb(244 239 229 / 88%); border-bottom: 1px solid rgb(217 209 196 / 75%); backdrop-filter: blur(14px); position: sticky; top: 0; z-index: 10; }
  .header-inner { align-items: center; display: grid; grid-template-columns: 1fr auto 1fr; min-height: 4.8rem; position: relative; }
  .brand { color: var(--moss-deep); font-family: "DM Mono", monospace; font-size: 1.15rem; font-weight: 500; letter-spacing: -0.08em; width: max-content; }
  .brand i { color: var(--clay); font-style: normal; }
  nav { display: flex; gap: 1.35rem; }
  .nav-link { color: var(--muted); font-size: 0.83rem; font-weight: 600; position: relative; }
  .nav-link::after { background: var(--clay); bottom: -0.5rem; content: ""; height: 2px; left: 50%; position: absolute; transform: scaleX(0) translateX(-50%); transform-origin: center; transition: transform .2s; width: 100%; }
  .nav-link:hover, .nav-link.active { color: var(--moss-deep); }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1) translateX(-50%); }
  .header-actions { align-items: center; display: flex; gap: .7rem; justify-self: end; margin-left: 2rem; }.contact-link { color: var(--moss); font-size: .82rem; font-weight: 700; }.contact-arrow { color: var(--clay); font-size: 1.1rem; margin-left: -.4rem; }
  @media (max-width: 920px) { .header-inner { grid-template-columns: 1fr auto; min-height: 4.35rem; padding-bottom: .55rem; } nav { -ms-overflow-style: none; display: flex; gap: .35rem; grid-column: 1 / -1; grid-row: 2; overflow-x: auto; padding-top: .2rem; scrollbar-width: none; width: 100%; }.nav-link { border: 1px solid var(--line); border-radius: 99px; font-size: .75rem; padding: .38rem .65rem; white-space: nowrap; }.nav-link::after { display: none; }.nav-link:hover, .nav-link.active { background: var(--moss-pale); border-color: var(--moss); color: var(--moss-deep); }.contact-link, .contact-arrow { display: none; }.header-actions { gap: .45rem; margin-left: 1rem; } nav::-webkit-scrollbar { display: none; } }
  @media (max-width: 390px) { .header-inner { min-height: 4rem; }.header-actions { gap: .3rem; }.brand { font-size: 1rem; }.language-switcher select { font-size: .6rem; padding-left: .5rem; padding-right: 1.3rem; } }
</style>
