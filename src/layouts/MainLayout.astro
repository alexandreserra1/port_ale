---
import "@/styles/global.css"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import ContactFormModal from "@/components/ContactFormModal.astro"

export interface Props {
  title?: string
}

const { title = "Portfólio" } = Astro.props
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const siteUrl = "https://alexandreserra1.github.io/port_ale"
const socialTitle = "Alexandre Serra | Software Engineer Portfolio"
const socialDescription = "Projetos de backend, engenharia de dados, sistemas distribuídos e IA aplicada."
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfólio pessoal e blog técnico de Alexandre Serra" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alexandre Serra" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:image" content={`${siteUrl}/images/alexandre-serra-hero.png`} />
    <meta property="og:image:alt" content="Alexandre Serra, Software Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={`${siteUrl}/images/alexandre-serra-hero.png`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} — Alexandre Serra</title>
    <script is:inline>document.documentElement.dataset.theme = localStorage.getItem("portfolio-theme") || "dark"</script>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <ContactFormModal />
  </body>
</html>
